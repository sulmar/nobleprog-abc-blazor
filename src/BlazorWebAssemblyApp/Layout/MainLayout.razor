@inherits AppStateLayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        

        <div class="top-row px-4">
            <button class="btn btn-dark" @onclick=@AppState.ToggleTheme>Theme: @AppState.CurrentTheme</button>

            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>




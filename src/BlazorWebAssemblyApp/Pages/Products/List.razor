@page "/products"
@using BlazorWebAssemblyApp.Services
@inject IProductService Api

<h3>Products</h3>

@if (products is null)
{
    <Placeholder Message="Loading products..." />
}
else
{
   <Table Items="@products">

       <HeaderTemplate>
           <tr>
               <th>Name</th>
               <th>Description</th>
               <th>Price</th>
           </tr>
       </HeaderTemplate>

       <RowTemplate Context="product">
           <tr>
               <td>@product.Name</td>
               <td>@product.Description</td>
               <td>@product.Price</td>
            </tr>
       </RowTemplate>

   </Table>
}

@code {

    private IEnumerable<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await Api.GetAll();

        // StateHasChanged(); // WPF: PropertyChanged()
    }
}


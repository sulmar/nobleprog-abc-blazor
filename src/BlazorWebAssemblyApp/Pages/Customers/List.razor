@page "/customers"
@using Domain.Models
@inject HttpClient Http

<h3>Customers</h3>

@if (customers is null)
{
    <p>Loading customers...</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
            </tr>             
        </thead>

        <tbody>                   
            @foreach(var customer in customers)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Email</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>Count: @customers.Count()</tr>
        </tfoot>

    </table>
}


<p>Your x: @x</p>

@code {

    private int x = 10;


}



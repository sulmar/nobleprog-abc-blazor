@page "/customers"
@using BlazorWebAssemblyApp.Services
@inject ICustomerService Api
@inherits AppStateComponentBase
@implements IDisposable

<h3 id="customers-label">Customers</h3>
@*

  two-way binding @bind-{property}
*@

<button class="btn btn-dark" @onclick=@AppState.ToggleTheme>Theme: @AppState.CurrentTheme</button>

<SearchPanel ValueChanged=@SearchAsync />



<CascadingValue Value="@x">
    <CascadingValue Value="@theme" Name="t">
        <CascadingValue Value="@name" Name="n">
            <Loader IsLoading=@isLoading>
                <CustomerTable Customers="@customers" />    
            </Loader>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>

    
@code {


    private IEnumerable<Customer>? customers;

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        customers = await Api.GetAll();

        isLoading = false;

        // StateHasChanged(); // WPF: PropertyChanged()
    }


    private async Task SearchAsync(string text)
    {
        Console.WriteLine($"Searching customers {text}...");

        await Task.Delay(3000);

        Console.WriteLine("Found.");
    }

    private string theme = "dark";

    private int x = 10;

    private string name = "Contor";

    private ApplicationContext AppContext = new ApplicationContext();
 

    public class ApplicationContext
    {
        public string Theme { get; set; }
        public string FontSize { get; set; }
    }

    
}




@page "/customers"
@using BlazorWebAssemblyApp.Services
@inject ICustomerService Api

<h3>Customers</h3>


<div id="search-panel">
    <input type="text" placeholder="What do you search?" @bind-value="@searchText" />
    <button class="btn btn-primary" @onclick="@Search">Search</button>
</div>

<Loader IsLoading=@isLoading>
    <CustomerTable Customers="@customers" />    
</Loader>
    

@code {

    private IEnumerable<Customer>? customers;

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        customers = await Api.GetAll();

        isLoading = false;

        // StateHasChanged(); // WPF: PropertyChanged()
    }

    private string searchText = "abc";


    private async Task Search()
    {
        await SearchAsync(searchText);
    }

    private async Task SearchAsync(string text)
    {
        Console.WriteLine($"Searching {text}...");

        await Task.Delay(3000);

        Console.WriteLine("Found.");
    }
}


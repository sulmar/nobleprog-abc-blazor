@page "/customers"
@using Domain.Models
@inject HttpClient Http

<h3>Customers</h3>

@if (customers is null)
{
    <p>Loading customers...</p>
}
else
{
    <ul>
        @foreach(var customer in customers)
        {
            <li>@customer.Name @customer.Email</li>
        }      
    </ul>
}


<p>Your x: @x</p>

@code {

    private int x = 10;


}




<Table Items="@Customers" Theme="@Theme">
    <HeaderTemplate>
        <tr>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </HeaderTemplate>
    <RowTemplate Context="customer">
        <tr>
            <td>@customer.Name</td>
            <td>@customer.Email</td>
        </tr>
    </RowTemplate>
</Table>

@code {

    [Parameter, EditorRequired]
    public required IEnumerable<Customer> Customers { get; set; }


    [Parameter]
    public string Theme { get; set; } = "light";

}
